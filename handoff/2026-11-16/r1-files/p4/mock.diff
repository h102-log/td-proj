+# ── 시안(P4, 머지하지 않는다) ──
+# Q·W·E·R을 쓸 영웅(후기 2 안 A): 고른 것 가운데 첫 산 출전 영웅. 고른 영웅이 없으면 null이다(그때는 첫 영웅이 쓰지만 표시하지 않는다)
+func _caster():
+	for u in controls.selected:
+		if u.is_hero and u.alive and u in battle.heroes:
+			return u
+	return null
+
+# 초상 테두리 모양: pick = S372 고른 칸(금색 테두리 + PRESS 바탕) · mate = 청록 테두리(발밑 팀 색, 바탕 그대로)
+func _look(name: String) -> StyleBox:
+	if not _looks.has(name):
+		var s := HudTheme.box("pressed", "Button", HudTheme.PRESS if name == "pick" else HudTheme.CELL, HudTheme.ACCENT if name == "pick" else SkillCell.TEAL)
+		s.set_content_margin_all(0)
+		_looks[name] = s
+	return _looks[name]
+
+# 초상 한 칸의 시안 표시: 고른 영웅 테두리(S369 ①), 스킬 쓸 영웅, 남은 대시 초. 쓰러진 영웅에는 아무것도 없다
+func _show_face(row: Dictionary, i: int, h, waiting: bool) -> void:
+	var picked: bool = mock != "" and h.alive and h in controls.selected
+	var casts: bool = mock != "" and h == _caster()
+	var look := ""
+	if picked:
+		look = "pick" if not "B" in mock or casts else "mate"
+	for st in ["normal", "hover"]:  # 누르고 있는 동안은 테마의 누름 모양(S372) 그대로다
+		if look == "":
+			row.face.remove_theme_stylebox_override(st)
+		else:
+			row.face.add_theme_stylebox_override(st, _look(look))
+	row.secs.visible = mock != "" and waiting
+	row.secs.text = str(ceili(h.dash_cd))
+	row.casts = casts
+	row.over.queue_redraw()
+	for slot in battle.SLOTS:  # 시안 A: 스킬 쓸 영웅의 스킬 칸 글자는 키 글자색(초상 «1», 태그 A·S·H와 같은 ACCENT)
+		slots[i][slot].tint_key(HudTheme.ACCENT if "A" in mock and casts else HudTheme.TEXT)
