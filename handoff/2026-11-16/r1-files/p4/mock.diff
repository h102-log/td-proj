+# ── 시안(P4, 머지하지 않는다) ──
+# 대시를 알아본다: 영웅의 dash_cd가 오른 프레임이다. 판 단계가 바뀐 프레임(원정에 들고 남)과 2칸보다 멀리 옮겨진 프레임(«다시»로 입구에 되돌려짐)은 뺀다.
+# 미끄러짐은 _slide_scan이 정한 그대로 읽기만 한다(8px 이하 짧은 대시는 미끄러짐이 없어 len 0)
+func _dash_scan(was: Dictionary) -> void:
+	for h in battle.heroes:
+		var id: int = h.get_instance_id()
+		var cd = _dash_cd.get(id)
+		var last = was.get(id)
+		if dash_mock != "" and _live and cd != null and last != null and h.alive and h.dash_cd > cd and battle.state == _dash_state:
+			var from: Vector2 = last[1]
+			var to := _center(h.pos)
+			if from.distance_to(to) <= battle.DASH.length * CELL + 0.5:
+				var s = _slides.get(id)
+				_n += 1
+				var far: float = clampf(from.distance_to(to) / (battle.DASH.length * CELL), 0.0, 1.0)
+				_dashes[id] = {"hero": h, "from": from, "to": to, "t0": clock, "len": s[2] if s != null and s[1] == clock else 0.0, "dir": _dir_of(to - from), "n": _n,
+					"far": far, "ghosts": clampi(ceili(from.distance_to(to) / DASH_STEP), 1, DASH_GHOSTS)}
+				_dash_dust(_dashes[id])
+		_dash_cd[id] = h.dash_cd
+	_dash_state = battle.state
+	for id in _dashes.keys():
+		if clock - _dashes[id].t0 > 1.0:
+			_dashes.erase(id)
+
+# 대시 먼지: 출발 자리에서 뒤쪽으로 DASH_KICK점을 차내고, 몸이 닿는 때(미끄러짐 끝) 착지 자리 앞·옆으로 DASH_LAND점이 낮게 퍼진다. 크기는 기존 먼지(S198)와 같은 2×2이고,
+# 흙길 위에서 DUST만으로는 묻혀서(2026-11-16 캡처) 크림색에서 DUST로 바뀐다. 짧게 끊긴 대시는 간 거리만큼 점 수와 날아가는 거리가 준다(4px 대시에 2칸짜리 먼지가 이는 것이 어색했다)
+func _dash_dust(d: Dictionary) -> void:
+	var back: Vector2 = (d.from - d.to).normalized()
+	var foot: Vector2 = d.from + Vector2(0, 2)
+	var reach: float = maxf(d.far, 0.5)
+	for i in clampi(roundi(DASH_KICK * d.far), 3, DASH_KICK):
+		var v := Vector2.from_angle(back.angle() + deg_to_rad(_h(d.n, i, -50, 50)))
+		_dot({"p0": foot, "p1": foot + Vector2(v.x, v.y * 0.6) * _h(d.n, 10 + i, 8, 16) * reach, "rise": _h(d.n, 20 + i, 1, 4), "col": PX.cream, "to": DUST, "size": Vector2(2, 2), "life": 0.3 + 0.02 * _h(d.n, 30 + i, 0, 4), "fade": 0.15})
+	var land: Vector2 = d.to + Vector2(0, 2)
+	for i in clampi(roundi(DASH_LAND * d.far), 2, DASH_LAND):
+		var v := Vector2.from_angle((-back).angle() + deg_to_rad(_h(d.n, 40 + i, -70, 70)))
+		_dot({"p0": land, "p1": land + Vector2(v.x, v.y * 0.6) * _h(d.n, 50 + i, 5, 9) * reach, "rise": _h(d.n, 60 + i, 0, 2), "col": PX.cream, "to": DUST, "size": Vector2(2, 2), "life": 0.3, "fade": 0.15, "wait": d.len})
+
+# 대시 잔상: 출발 → 도착 길의 잔상 자리에, 미끄러지는 몸이 그 자리를 지난 때부터 DASH_GHOST초 동안 사라진다(출발 쪽부터 사라진다). 몸통 아래 층이다.
+# 잔상 수는 간 거리 ÷ DASH_STEP(2칸이면 넷)이라 짧게 끊긴 대시에서 겹쳐 덩어리지지 않는다. 미끄러짐이 없는 짧은 대시는 출발 자리 하나가 툭 옮겨진 두 자리를 잇는다
+func _dash_ghosts() -> void:
+	for d in _dashes.values():
+		var t: float = clock - d.t0
+		for i in int(d.ghosts):
+			var u: float = float(i) / d.ghosts
+			var k: float = (t - d.len * (1.0 - sqrt(1.0 - u))) / DASH_GHOST  # _out으로 미끄러지는 몸이 u 자리를 지나는 때는 len × (1 − √(1 − u))다
+			if k < 0.0 or k >= 1.0:
+				continue
+			var p: Vector2 = d.from.lerp(d.to, u).round()
+			if dash_mock == "bar":
+				var tall := int(_head(d.hero) * 0.8)
+				var col := Color(_ramp(["cream", "tan", "ash"], k), DASH_ALPHA * (1.0 - k))
+				_px(Vector2i(p) + Vector2i(-1, -tall), col, Vector2i(3, tall))
+				_px(Vector2i(p) + Vector2i(-2, -tall + 2), col, Vector2i(5, tall - 4))
+			elif dash_mock == "sil":
+				var step: Array = DASH_SIL[clampi(int(k * DASH_SIL.size()), 0, DASH_SIL.size() - 1)]
+				_hero_sil(d.hero.kind, p, d.dir, Color(PX[step[0]], step[1]))
+			else:
+				_hero_frame(d.hero.kind, p, "walk", 1, d.dir, Color(1, 1, 1, DASH_ALPHA * (1.0 - k)))
+
+# 영웅 그림 한 칸을 발 자리 가운데 p에 그린다(_sprite의 마지막 줄과 같은 셈). 잔상이 쓴다
+func _hero_frame(kind: String, p: Vector2, anim: String, col: int, dir: int, tint: Color) -> void:
+	if not ART.has(kind):
+		return
+	var a: Dictionary = ART[kind]
+	var c := int(a.c)
+	var size := c * (2 if anim == "attack" else 1)
+	_region(UNITS, Rect2(p - Vector2(a.anchor[0], a.anchor[1]) - Vector2.ONE * (size - c) / 2.0, Vector2(size, size)), Rect2(col * size, a[anim] + dir * size, size, size), tint)
+
+# 영웅 걷기 그림(내딛는 칸)의 단색 실루엣을 발 자리 가운데 p에 그린다. 실루엣은 그 칸의 불투명한 점을 모두 흰색으로 바꾼 그림이고 색은 tint가 정한다
+func _hero_sil(kind: String, p: Vector2, dir: int, tint: Color) -> void:
+	if not ART.has(kind):
+		return
+	var a: Dictionary = ART[kind]
+	var c := int(a.c)
+	var key := "%s:%d" % [kind, dir]
+	if not _sils.has(key):
+		if _units_img == null:
+			_units_img = UNITS.get_image()
+		var im := _units_img.get_region(Rect2i(c, int(a.walk) + dir * c, c, c))
+		im.convert(Image.FORMAT_RGBA8)
+		for y in c:
+			for x in c:
+				im.set_pixel(x, y, Color(1, 1, 1, 1.0 if im.get_pixel(x, y).a > 0.5 else 0.0))
+		_sils[key] = ImageTexture.create_from_image(im)
+	_region(_sils[key], Rect2(p - Vector2(a.anchor[0], a.anchor[1]), Vector2(c, c)), Rect2(0, 0, c, c), tint)
+
 # 미끄러지는 몸을 그릴 자리와 시뮬레이션 자리의 차(S198)
