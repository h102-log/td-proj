+func _face_paint(i: int) -> void:
+	var row: Dictionary = _rows[i]
+	if mock != "" and _now - row.reject < SkillCell.FLASH:
+		row.over.draw_rect(Rect2(Vector2.ZERO, row.over.size).grow(-0.5), HudTheme.DANGER, false, 1.0)
+	if "C" in mock and row.get("casts", false):
+		if _pointer == null:
