+		row.over.draw_texture(_pointer, Vector2(20, 7))  # 세모 끝이 초상과 Q 칸 사이 1px 틈(x 24)에 닿는다
+
+# 대기 중 Space(후기 3 안 A): 아무도 대시하지 못했고 그 까닭이 대기일 때 controls가 알린다. 대기 중인 영웅의 초상 테두리를 번쩍이고 토스트와 refuse 소리를 낸다
+func _dash_refuse(waiting: Array) -> void:
+	if mock == "":
+		return
+	var left := INF
+	for h in waiting:
+		_rows[battle.heroes.find(h)].reject = _now
+		left = minf(left, h.dash_cd)
+	toasts.push("대시 대기 %d초" % ceili(left))
+	Audio.of(get_tree()).play("refuse")
+
